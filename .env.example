# Copia este archivo como .env.local y completa los valores.
# .env.local NO se sube a GitHub.

# Pueden ir en el navegador (por eso llevan NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOLO servidor: URL del backend de Spring Boot al que el proxy reenvía /api/v1.
# En local: http://localhost:8080. En Vercel: https://inmocheck-backend-qskl.onrender.com
# La llave service_role ya NO va en el front: solo la usa el backend (backend/.env y Render).
BACKEND_URL=
