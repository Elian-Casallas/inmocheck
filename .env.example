# Copia este archivo como .env.local y completa los valores.
# .env.local NO se sube a GitHub.

# Pueden ir en el navegador (por eso llevan NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOLO servidor: salta las políticas RLS. Nunca ponerle NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# SOLO servidor: URL del backend de Spring Boot al que el proxy reenvía /api/v1.
# En local: http://localhost:8080. En Vercel: la URL HTTPS de AWS.
BACKEND_URL=
