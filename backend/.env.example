# Copia este archivo como backend/.env y llena los valores.
# backend/.env no se sube a git.

# URL del proyecto de Supabase (la misma NEXT_PUBLIC_SUPABASE_URL del front).
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Base de datos: en Supabase, botón "Connect" → "Direct" → Method "Session pooler", Type "JDBC".
# Usa los "Connection parameters": host, user y la clave de la base.
SUPABASE_DB_URL=jdbc:postgresql://HOST-DEL-POOLER:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.TU-PROYECTO
SUPABASE_DB_PASSWORD=la-clave-de-la-base
