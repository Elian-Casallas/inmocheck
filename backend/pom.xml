<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>

	<groupId>com.inmocheck</groupId>
	<artifactId>inmocheck-backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>inmocheck-backend</name>
	<description>API REST de InmoCheck (reemplaza el BFF de Next.js)</description>

	<properties>
		<java.version>21</java.version>
	</properties>

	<!--
		Solo lo que necesita la tarea 5.2 (arrancar y responder /actuator/health).
		Security y OAuth2 Resource Server llegan en la 5.3; JDBC y el driver de
		PostgreSQL en la 5.4. Si se agregaran antes, la app no arrancaría sin
		la configuración de la base ni dejaría pasar la petición de salud.
	-->
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>
